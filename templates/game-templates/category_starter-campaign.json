{
  "id": "category_starter_campaign",
  "name": "Starter Campaign (New Category)",
  "description": "A basic template for a new TTRPG campaign creating a Custom Category with all channels, including general chat, GM-only, and player-only channels.",
  "creationStyle": "new_category",
  "categoryPermissions": [
    { "target": "@everyone", "allow": ["ViewChannel"], "deny": [] },
    { "target": "{GM_ROLE_ID}", "profileId": "gm_basic_profile", "allow": [], "deny": [] },
    { "target": "{PLAYER_ROLE_ID}", "profileId": "player_basic_profile", "allow": [], "deny": [] }
  ],
  "channels": [
    {
      "name": "general-chat",
      "type": "text",
      "topic": "General discussion for the campaign.",
      "permissions": [],
      "forumTags": []
    },
    {
      "name": "gm-chat",
      "type": "text",
      "topic": "GM-only discussions and planning.",
      "permissions": [
        { "target": "@everyone", "allow": [], "deny": ["ViewChannel"] },
        { "target": "{GM_ROLE_ID}", "profileId": "gm_basic_profile", "allow": [], "deny": [] }
      ],
      "initialThreads": [
        {
          "name": "GM Notes",
          "message": "This is a private thread for GM notes and secret planning. Players cannot see this!",
          "isPrivate": true, 
          "tags": []
        }
      ],
      "forumTags": []
    },
    {
      "name": "player-chat",
      "type": "text",
      "topic": "Player-only discussions and planning.",
      "permissions": [
        { "target": "@everyone", "allow": [], "deny": ["ViewChannel"] },
        { "target": "{GM_ROLE_ID}", "profileId": "gm_basic_profile", "allow": [], "deny": [] },
        { "target": "{PLAYER_ROLE_ID}", "profileId": "player_basic_profile", "allow": [], "deny": [] }
      ],
      "forumTags": []
    },
    {
      "name": "player-lfg",
      "type": "text",
      "topic": "Looking for Group / Player Introductions",
      "permissions": [],
      "forumTags": []
    },
    {
      "name": "session-logs",
      "type": "forum",
      "topic": "Recaps and logs from game sessions.",
      "permissions": [],
      "forumTags": ["Session 1", "Session 2", "Recap"],
      "initialThreads": [
        {
          "name": "Welcome to Session Logs!",
          "message": "This is where we'll keep track of all our game sessions. Feel free to create new posts for recaps, questions, or discussions about past games. Use the 'Recap' tag for session summaries!",
          "isPrivate": false,
          "tags": ["Recap"]
        }        
      ]
    }
  ]
}
