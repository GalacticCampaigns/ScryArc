{
  "id": "starter_campaign",
  "name": "Starter Campaign (Default)",
  "description": "A basic template for a new TTRPG campaign, including general chat, GM-only, and player-only channels.",
  "creationStyle": "new_category",
  "defaultGMProfileId": null,
  "categoryPermissions": [
    { "target": "@everyone", "allow": ["ViewChannel"], "deny": [] },
    { "target": "{GM_ROLE_ID}", "allow": ["ManageChannels", "ManageRoles", "KickMembers", "MuteMembers"], "deny": [] }
  ],
  "channels": [
    {
      "name": "general-chat",
      "type": "text",
      "topic": "General discussion for the campaign.",
      "permissions": [
        { "target": "@everyone", "allow": ["SendMessages", "ReadMessageHistory"], "deny": [] },
        { "target": "{GM_ROLE_ID}", "allow": ["ManageMessages"], "deny": [] }
      ],
      "forumTags": []
    },
    {
      "name": "gm-chat",
      "type": "text",
      "topic": "GM-only discussions and planning.",
      "permissions": [
        { "target": "@everyone", "allow": [], "deny": ["ViewChannel"] }
      ],
      "forumTags": []
    },
    {
      "name": "player-chat",
      "type": "text",
      "topic": "Player-only discussions and planning.",
      "permissions": [
        { "target": "@everyone", "allow": [], "deny": ["ViewChannel"] },
        { "target": "{PLAYER_ROLE_ID}", "allow": ["ViewChannel", "SendMessages", "ReadMessageHistory"], "deny": [] },
        { "target": "{GM_ROLE_ID}", "allow": ["ViewChannel", "SendMessages", "ReadMessageHistory"], "deny": [] }
      ],
      "forumTags": []
    },
    {
      "name": "player-lfg",
      "type": "text",
      "topic": "Looking for Group / Player Introductions",
      "permissions": [],
      "forumTags": []
    },
    {
      "name": "session-logs",
      "type": "forum",
      "topic": "Recaps and logs from game sessions.",
      "permissions": [],
      "forumTags": ["Session 1", "Session 2", "Recap"],
      "initialThreads": [
        {
          "name": "Welcome to Session Logs!",
          "message": "This is where we'll keep track of all our game sessions. Feel free to create new posts for recaps, questions, or discussions about past games. Use the 'Recap' tag for session summaries!",
          "isPrivate": false,
          "tags": ["Recap"]
        },
        {
          "name": "GM Notes (Private)",
          "message": "This is a private thread for GM notes and secret planning. Players cannot see this!",
          "isPrivate": true, 
          "tags": []
        }
      ]
    }
  ]
}
